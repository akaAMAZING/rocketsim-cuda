+#[cfg(feature = "dump")]
+impl RigidBody {
+    /// The activation state's code in the dump: 0 active, 1 sleeping, 2 simulation disabled, 3 wants deactivation.
+    pub(crate) const fn activation_code(&self) -> u8 {
+        match self.activation {
+            ActivationState::Active => 0,
+            ActivationState::Sleeping => 1,
+            ActivationState::DisableSimulation => 2,
+            ActivationState::WantsDeactivation => 3,
+        }
+    }
+
+    /// State dump of the fields Bullet keeps between steps.
+    pub(crate) fn dump_io<I: crate::dump::Io>(&mut self, io: &mut I) {
+        io.u8(&mut self.collision_flags);
+        crate::dump::opt_idx(io, &mut self.companion_id);
+        let mut activation = self.activation_code();
+        io.u8(&mut activation);
+        self.activation = match activation {
+            1 => ActivationState::Sleeping,
+            2 => ActivationState::DisableSimulation,
+            3 => ActivationState::WantsDeactivation,
+            _ => ActivationState::Active,
+        };
+        io.aff3(&mut self.world_trans);
+        io.quat(&mut self.world_quat);
+        io.aff3(&mut self.interp_world_trans);
+        io.f32(&mut self.deactivation_time);
+        io.vec3(&mut self.lin_vel);
+        io.vec3(&mut self.ang_vel);
+        io.mat3(&mut self.inv_inertia_tensor_world);
+        io.vec3(&mut self.accum_lin_vel);
+        io.vec3(&mut self.accum_ang_vel);
+        io.f32(&mut self.cached_linear_damping);
+        io.f32(&mut self.cached_damping_time_step);
+        io.f32(&mut self.cached_linear_damping_value);
+    }
+
+    /// State dump of the construction constants of this body; `group` and `mask` come from its proxy.
+    /// `collision_flags` is state (a demolished car sets NoContactResponse), see `dump_io`.
+    pub(crate) fn dump_static(&self, w: &mut crate::dump::Wr, group: u8, mask: u8) {
+        w.put_idx(self.world_array_idx);
+        w.put_u8(self.user_idx as u8);
+        w.put_idx(self.user_pointer);
+        w.put_idx(self.broadphase_handle);
+        w.put_u8(group);
+        w.put_u8(mask);
+        w.put_f32(self.mass);
+        w.put_f32(self.inv_mass);
+        w.put_vec3(self.inv_inertia_local);
+        w.put_vec3(self.inv_mass_splat);
+        w.put_f32(self.friction);
+        w.put_f32(self.restitution);
+        w.put_f32(self.contact_processing_threshold);
+        w.put_f32(self.contact_breaking_threshold);
+        w.put_f32(self.linear_damping);
+        w.put_f32(self.linear_sleeping_threshold);
+        w.put_f32(self.angular_sleeping_threshold);
+        // static bodies never move: their pose is a constant (dynamic bodies carry identity here)
+        if self.is_static_obj() {
+            w.put_aff3(&self.world_trans);
+        } else {
+            w.put_aff3(&Affine3A::IDENTITY);
+        }
+        match &self.shape {
+            CollisionShapes::TriangleMesh(_) => w.put_u8(0),
+            CollisionShapes::StaticPlane(_) => w.put_u8(1),
+            CollisionShapes::Sphere(s) => {
+                w.put_u8(2);
+                w.put_vec3(s.convex_internal_shape.implicit_dim);
+                w.put_f32(s.convex_internal_shape.margin);
+            }
+            CollisionShapes::Compound(c) => {
+                w.put_u8(3);
+                w.put_vec3(c.child_shape.get_half_extents());
+                w.put_f32(c.child_shape.get_margin());
+                w.put_aff3(&c.child_trans);
+                w.put_aabb(c.get_ident_aabb());
+            }
+            CollisionShapes::ConvexHull(_) | CollisionShapes::Triangle(_) => {
+                panic!("dump: shape kind not used by Soccar")
+            }
+        }
+    }
+}
