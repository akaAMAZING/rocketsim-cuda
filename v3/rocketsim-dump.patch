diff --git a/rocketsim/src/bullet/dynamics/discrete_dynamics_world.rs b/rocketsim/src/bullet/dynamics/discrete_dynamics_world.rs
index 57aa0c7..5b01eae 100644
--- a/rocketsim/src/bullet/dynamics/discrete_dynamics_world.rs
+++ b/rocketsim/src/bullet/dynamics/discrete_dynamics_world.rs
@@ -303,3 +303,164 @@ impl DiscreteDynamicsWorld {
         self.internal_single_step_simulation(time_step, contact_added_callback);
     }
 }
+
+#[cfg(feature = "trace")]
+impl DiscreteDynamicsWorld {
+    /// P2: `step_simulation` up to and including `predict_unconstraint_motion`.
+    pub(crate) fn trace_p2(&mut self, time_step: f32) {
+        self.apply_gravity(time_step);
+        self.predict_unconstraint_motion(time_step);
+    }
+
+    /// P3a: the first half of `perform_discrete_collision_detection` (AABB update and sweep-and-prune).
+    pub(crate) fn trace_p3a(&mut self) {
+        self.collision_world.update_aabbs();
+    }
+
+    /// P3b: the second half of `perform_discrete_collision_detection` (narrowphase in pair order).
+    pub(crate) fn trace_p3b<T: ContactAddedCallback>(&mut self, contact_added_callback: &mut T) {
+        let cw = &mut self.collision_world;
+        cw.dispatcher1.dispatch_all_collision_pairs(
+            &cw.collision_objs,
+            &mut cw.broadphase_pair_cache,
+            contact_added_callback,
+        );
+    }
+
+    /// P4: `sort_manifolds` (island union-find over the retained dynamic pairs, the sleep of bodies that want
+    /// deactivation in islands without an active body, then the manifold sort).
+    pub(crate) fn trace_p4(&mut self) {
+        let dynamic_pairs = self
+            .collision_world
+            .broadphase_pair_cache
+            .overlapping_dynamic_body_pairs();
+        self.island_manager.sort_manifolds(
+            &mut self.collision_world.collision_objs,
+            &self.dynamic_body_idcs,
+            dynamic_pairs,
+            &self.collision_world.dispatcher1.persistent_manifolds,
+            &mut self.collision_world.dispatcher1.active_manifolds,
+        );
+    }
+
+    /// P5: the solver (`solve_group`).
+    pub(crate) fn trace_p5(&mut self, time_step: f32) {
+        let ball_only = self.ball_only
+            && self.dynamic_body_idcs.len() == 1
+            && self.collision_world.collision_objs[self.dynamic_body_idcs[0]].user_idx
+                == UserInfoType::Ball;
+        self.solver.skip_separated_special_rows = ball_only;
+        self.solve_constraints(time_step);
+    }
+
+    /// P6: `integrate_trans` and `update_activation_state`.
+    pub(crate) fn trace_p6(&mut self, time_step: f32) {
+        self.integrate_trans(time_step);
+        self.update_activation_state(time_step);
+    }
+}
+
+#[cfg(feature = "dump")]
+impl DiscreteDynamicsWorld {
+    /// State dump of the world's mutable state: bodies, dispatcher, broadphase, island manager.
+    /// The constraint solver keeps no state across ticks: its pools are cleared at the end of every solve and its
+    /// `fixed_body_id`, `companion_id` links and residual are reassigned before they are read.
+    pub(crate) fn dump_io<I: crate::dump::Io>(&mut self, io: &mut I) {
+        use crate::dump::tag;
+        io.tag(tag(b"BODY"));
+        let n = io.len(self.collision_world.collision_objs.len());
+        assert_eq!(
+            n,
+            self.collision_world.collision_objs.len(),
+            "dump: body count"
+        );
+        for body in &mut self.collision_world.collision_objs {
+            body.dump_io(io);
+        }
+        io.tag(tag(b"DISP"));
+        self.collision_world.dispatcher1.dump_io(io);
+        io.tag(tag(b"BROA"));
+        self.collision_world.broadphase_pair_cache.dump_io(io);
+        io.tag(tag(b"ISLD"));
+        self.island_manager.dump_io(io);
+        io.bool(&mut self.ball_only);
+    }
+
+    /// State dump of the world constants and the static bodies' collision data.
+    pub(crate) fn dump_static(&self, s: &mut crate::dump::StaticSections, full: bool) {
+        use crate::bullet::collision::shapes::collision_shape::CollisionShapes;
+        let c = &mut s.counts;
+        s.world.put_vec3(self.gravity);
+        s.world.put_idx(self.dynamic_body_idcs.len());
+        for &i in &self.dynamic_body_idcs {
+            s.world.put_idx(i);
+        }
+        let broadphase = &self.collision_world.broadphase_pair_cache;
+        let [n_cells, entries] = broadphase.dump_static(&mut s.world, &mut s.cells);
+        c[10] = n_cells;
+        c[11] = entries;
+
+        let bodies = &self.collision_world.collision_objs;
+        c[0] = bodies.len() as u32;
+        c[1] = self.dynamic_body_idcs.len() as u32;
+        s.bodies.put_idx(bodies.len());
+        for (i, body) in bodies.iter().enumerate() {
+            let (group, mask) = broadphase.dump_filter(body.get_broadphase_handle());
+            body.dump_static(&mut s.bodies, group, mask);
+            match body.get_collision_shape() {
+                CollisionShapes::TriangleMesh(mesh) => {
+                    c[2] += 1;
+                    c[3] += mesh.get_mesh_interface().get_total_num_faces() as u32;
+                    s.bodies
+                        .put_idx(mesh.get_mesh_interface().get_total_num_faces());
+                    if full {
+                        s.meshes.put_idx(i);
+                        mesh.dump_static(&mut s.meshes, c);
+                    }
+                }
+                CollisionShapes::StaticPlane(plane) => {
+                    c[7] += 1;
+                    s.planes.put_idx(i);
+                    plane.dump_static(&mut s.planes);
+                }
+                _ => {}
+            }
+        }
+    }
+
+    /// The static broadphase proxies, after the pads.
+    pub(crate) fn dump_proxies(&self, w: &mut crate::dump::Wr) {
+        self.collision_world.broadphase_pair_cache.dump_proxies(w);
+    }
+
+    pub(crate) fn dump_stats(&self) -> crate::dump::SolverStats {
+        self.solver.dump_stats
+    }
+
+    pub(crate) fn reset_dump_stats(&mut self) {
+        self.solver.dump_stats = Default::default();
+    }
+}
+
+#[cfg(feature = "dump")]
+impl DiscreteDynamicsWorld {
+    /// Header counts of the world: bodies, retained manifolds, active manifolds, manifold points, manifold table
+    /// length, sweep-and-prune handles, retained pairs, dynamic ray-cell entries.
+    pub(crate) fn dump_counts(&self) -> [u32; 8] {
+        let d = &self.collision_world.dispatcher1;
+        let [handles, pairs, cells] = self.collision_world.broadphase_pair_cache.dump_counts();
+        [
+            self.collision_world.collision_objs.len() as u32,
+            d.persistent_manifolds.len() as u32,
+            d.active_manifolds.len() as u32,
+            d.persistent_manifolds
+                .iter()
+                .map(|m| m.point_cache.len() as u32)
+                .sum(),
+            d.dump_table_len() as u32,
+            handles,
+            pairs,
+            cells,
+        ]
+    }
+}
