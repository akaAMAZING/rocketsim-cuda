+/// Phase-split `step_tick` (feature `trace`). Boundary `k` is the state before phase `k`
+/// (boundary 0 = the start of a tick, boundary [`PHASES`] = the end of it). Running phases `0..PHASES` in order is
+/// `step_tick`; `step_tick` itself is untouched, so the two stay independent witnesses of each other.
+#[cfg(feature = "trace")]
+pub const PHASES: usize = 10;
+
+/// Phase names by index: P0, P1, P2, P3a, P3b, P4, P5, P6, P7, P8.
+#[cfg(feature = "trace")]
+pub const PHASE_NAMES: [&str; PHASES] = ["P0", "P1", "P2", "P3a", "P3b", "P4", "P5", "P6", "P7", "P8"];
+
+#[cfg(feature = "trace")]
+impl Arena {
+    /// Runs phase `k` (0..PHASES) of the tick. Same statements, same order as `step_tick`; the cuts are marked.
+    pub fn step_phase(&mut self, k: usize) {
+        match k {
+            // P0: clear forces; limit_vels and quantize for cars and ball
+            0 => {
+                self.events.clear();
+                self.bullet_world.clear_accum_forces();
+                {
+                    use consts::{ball, car};
+
+                    if !self.ball_only {
+                        for car_idx in 0..self.cars.len() {
+                            let car_rb = &mut self.bullet_world.bodies_mut()
+                                [self.cars[car_idx].rigid_body_idx];
+                            car_rb.limit_vels(car::MAX_SPEED * UU_TO_BT, car::MAX_ANG_SPEED);
+                            quantize::quantize(car_rb);
+                            self.cars[car_idx].state.phys.vel = car_rb.lin_vel * BT_TO_UU;
+                            self.cars[car_idx].state.phys.ang_vel = car_rb.ang_vel;
+                        }
+                    }
+                    let ball_rb = &mut self.bullet_world.bodies_mut()[self.ball.rigid_body_idx];
+                    ball_rb.limit_vels(
+                        self.config.mutators.ball_max_speed * UU_TO_BT,
+                        ball::MAX_ANG_SPEED,
+                    );
+                    quantize::quantize(ball_rb);
+                    self.ball.state.phys.vel = ball_rb.lin_vel * BT_TO_UU;
+                    self.ball.state.phys.ang_vel = ball_rb.ang_vel;
+                }
+            }
+            // P1: flip z-damp prepass; car pre_tick_update in index order; ball pre_tick_update; ball_only flags
+            1 => {
+                if !self.ball_only {
+                    for car in &mut self.cars {
+                        car.apply_flip_zdamp_prepass(&mut self.bullet_world);
+                    }
+
+                    for car_idx in 0..self.cars.len() {
+                        let was_on_ground = self.cars[car_idx].state.cache.is_on_ground;
+                        self.cars[car_idx].pre_tick_update(
+                            &mut self.bullet_world,
+                            &mut self.rng,
+                            self.config.game_mode,
+                            &self.config.mutators,
+                        );
+                        if !was_on_ground && self.cars[car_idx].state.cache.is_on_ground {
+                            self.events.push(ArenaEvent::CarLanded(CarLandedEvent {
+                                car_idx,
+                                wheels: self.cars[car_idx].state.cache.wheels_with_contact,
+                            }));
+                        }
+                    }
+                }
+
+                self.ball.pre_tick_update(
+                    &mut self.bullet_world.bodies_mut()[self.ball.rigid_body_idx],
+                    self.config.game_mode,
+                );
+
+                let ball_only = self.ball_only;
+                self.contact_tracker.set_ball_only(ball_only);
+                self.bullet_world.set_ball_only(ball_only);
+            }
+            // P2: Bullet step_simulation: gravity, predict_unconstraint_motion
+            2 => self.bullet_world.trace_p2(TICK_TIME),
+            // P3a: AABB update and sweep-and-prune
+            3 => self.bullet_world.trace_p3a(),
+            // P3b: narrowphase dispatch in pair order
+            4 => self.bullet_world.trace_p3b(&mut self.contact_tracker),
+            // P4: sort_manifolds
+            5 => self.bullet_world.trace_p4(),
+            // P5: solve_group
+            6 => self.bullet_world.trace_p5(TICK_TIME),
+            // P6: integrate_trans, update_activation_state
+            7 => self.bullet_world.trace_p6(TICK_TIME),
+            // P7: contact post-processing in record order
+            8 => {
+                let ball_only = self.ball_only;
+                if ball_only {
+                    let contact_count = self.contact_tracker.num_ball_world_records();
+                    for idx in 0..contact_count {
+                        let contact = *self.contact_tracker.get_ball_world_record(idx);
+                        self.on_ball_world_collision_parts(
+                            contact.rb_idx,
+                            contact.contact_point,
+                            contact.contact_normal,
+                        );
+                    }
+                } else {
+                    let contact_count = self.contact_tracker.num_records();
+                    for idx in 0..contact_count {
+                        let contact = *self.contact_tracker.get_record(idx);
+
+                        let bodies = self.bullet_world.bodies();
+                        let rb_a = &bodies[contact.rb_idx_a];
+                        let rb_b = &bodies[contact.rb_idx_b];
+                        let user_idx_a = rb_a.user_idx;
+                        let user_idx_b = rb_b.user_idx;
+                        let user_pointer_a = rb_a.user_pointer;
+                        let user_pointer_b = rb_b.user_pointer;
+
+                        match user_idx_a {
+                            UserInfoType::Car => match user_idx_b {
+                                UserInfoType::Ball => {
+                                    self.on_car_ball_collision(
+                                        user_pointer_a,
+                                        &contact.manifold_point,
+                                        contact.is_swap,
+                                    );
+                                }
+                                UserInfoType::Car => {
+                                    self.on_car_car_collision(
+                                        user_pointer_a,
+                                        user_pointer_b,
+                                        &contact.manifold_point,
+                                    );
+                                }
+                                _ => self
+                                    .on_car_world_collision(user_pointer_a, &contact.manifold_point),
+                            },
+                            UserInfoType::Ball => match user_idx_b {
+                                UserInfoType::DropshotTile => {
+                                    self.on_ball_tile_collision(user_pointer_b);
+                                }
+                                UserInfoType::None => {
+                                    self.on_ball_world_collision(
+                                        &contact.manifold_point,
+                                        contact.rb_idx_a,
+                                    );
+                                }
+                                _ => {}
+                            },
+                            _ => {}
+                        }
+                    }
+                }
+
+                self.contact_tracker.clear_records();
+            }
+            // P8: car post_tick_update, finish_physics_tick, pad pickup; ball finish; tick_count += 1
+            9 => {
+                if !self.ball_only {
+                    for car in &mut self.cars {
+                        car.post_tick_update(&mut self.bullet_world);
+                        let rb = &mut self.bullet_world.bodies_mut()[car.rigid_body_idx];
+                        car.finish_physics_tick(rb);
+                    }
+
+                    if self.config.mutators.boost_pads_enabled
+                        && let Some(grid) = self.boost_pad_grid.as_mut()
+                    {
+                        grid.update_membership(&self.cars, self.config.mutators.car_max_boost_amount);
+
+                        for car_idx in 0..self.cars.len() {
+                            let collected = {
+                                let car = &mut self.cars[car_idx];
+                                grid.maybe_give_car_boost(
+                                    &mut car.state,
+                                    &self.config.mutators,
+                                    self.tick_count,
+                                    car_idx,
+                                )
+                            };
+
+                            if let Some(boost_pad_idx) = collected {
+                                self.events.push(CarPickupBoost(CarPickupBoostEvent {
+                                    car_idx,
+                                    boost_pad_idx,
+                                }));
+                                grid.refresh_winner(
+                                    boost_pad_idx,
+                                    &self.cars,
+                                    self.config.mutators.car_max_boost_amount,
+                                );
+                            }
+                        }
+                    }
+                }
+
+                let ball_rb = &mut self.bullet_world.bodies_mut()[self.ball.rigid_body_idx];
+                self.ball.finish_physics_tick(ball_rb);
+
+                if self.config.game_mode == GameMode::Dropshot
+                    && self.ball.state.ds_info.last_damage_tick == Some(self.tick_count)
+                {
+                    self.update_tile_states();
+                }
+
+                self.tick_count += 1;
+            }
+            _ => panic!("step_phase: phase {k} out of range (0..{PHASES})"),
+        }
+    }
+}
+
+#[cfg(feature = "dump")]
+impl Arena {
+    /// Header counts: the world's, then cars, pads and the two contact-record lists.
+    fn dump_counts(&self) -> [u32; crate::dump::ARENA_COUNTS] {
+        let w = self.bullet_world.dump_counts();
+        let pads = self.boost_pad_grid.as_ref();
+        [
+            w[0],
+            w[1],
+            w[2],
+            w[3],
+            w[4],
+            w[5],
+            w[6],
+            w[7],
+            self.cars.len() as u32,
+            pads.map_or(0, |g| g.all_pads.len() as u32),
+            self.contact_tracker.num_records() as u32,
+            self.contact_tracker.num_ball_world_records() as u32,
+        ]
+    }
+
+    fn dump_io<I: crate::dump::Io>(&mut self, io: &mut I) {
+        use crate::dump::{io_ball, io_car, io_pad, tag};
+        assert!(
+            self.tile_states.is_none(),
+            "dump: Dropshot tiles are not exported"
+        );
+        io.tag(tag(b"ARNA"));
+        io.u64(&mut self.tick_count);
+        let mut seed = self.rng.get_seed();
+        io.u64(&mut seed);
+        self.rng.seed(seed);
+        io.bool(&mut self.ball_only);
+        io.tag(tag(b"BALL"));
+        io_ball(io, &mut self.ball);
+        io.tag(tag(b"CARS"));
+        let n = io.len(self.cars.len());
+        assert_eq!(n, self.cars.len(), "dump: car count");
+        for car in &mut self.cars {
+            io_car(io, car);
+        }
+        io.tag(tag(b"PADS"));
+        let mut no_pads = Vec::new();
+        let pads = self
+            .boost_pad_grid
+            .as_mut()
+            .map_or(&mut no_pads, |g| &mut g.all_pads);
+        let n = io.len(pads.len());
+        assert_eq!(n, pads.len(), "dump: pad count");
+        for pad in pads.iter_mut() {
+            io_pad(io, pad);
+        }
+        io.tag(tag(b"CONT"));
+        self.contact_tracker.dump_io(io);
+        self.bullet_world.dump_io(io);
+    }
+
+    /// State dump: every piece of per-arena mutable state that persists across ticks.
+    /// It is exported from a clone, so that one traversal serves export and import. `vis` and the last tick's
+    /// `events` are not state (the events are cleared at the start of every `step_tick`).
+    pub fn export_state(&self) -> crate::dump::ArenaDump {
+        use crate::dump::{ARENA_MAGIC, VERSION, Wr};
+        let mut w = Wr::default();
+        w.0.extend_from_slice(&ARENA_MAGIC);
+        w.put_u32(VERSION);
+        w.put_u64(self.config_hash());
+        for c in self.dump_counts() {
+            w.put_u32(c);
+        }
+        self.clone().dump_io(&mut w);
+        crate::dump::ArenaDump(w.0)
+    }
+
+    /// Restores a dump taken by [`Arena::export_state`] into an arena built from the same config and the same
+    /// loaded meshes (checked through `config_hash`). Replaces all the per-arena state of the dump, so that
+    /// stepping continues bit for bit as the exported arena would have.
+    pub fn import_state(&mut self, dump: &crate::dump::ArenaDump) -> Result<(), String> {
+        use crate::dump::{ArenaDump, Rd};
+        let bytes = dump.as_bytes();
+        let checked = ArenaDump::from_bytes(bytes.to_vec())?;
+        if checked.config_hash() != self.config_hash() {
+            return Err("the dump comes from a different configuration (config_hash)".into());
+        }
+        let mut r = Rd::new(&bytes[ArenaDump::HEADER_LEN..]);
+        self.dump_io(&mut r);
+        if let Some(e) = r.err {
+            return Err(e.into());
+        }
+        if r.remaining() != 0 {
+            return Err(format!("{} trailing bytes", r.remaining()));
+        }
+        if self.dump_counts() != checked.counts() {
+            return Err("header counts do not match the imported structures".into());
+        }
+        self.events.clear();
+        Ok(())
+    }
+
+    /// FNV-1a 64 over the constant sections of the static dump (WRLD, BODY, PLAN, CARS, PADS: everything but the
+    /// meshes and the static ray cells), tags and counts included.
+    pub fn config_hash(&self) -> u64 {
+        let (_, sections) = self.static_sections(false);
+        let mut cfg = Vec::new();
+        for (t, bytes) in &sections {
+            if t != b"MESH" && t != b"CELL" && t != b"PROX" {
+                cfg.extend_from_slice(bytes);
+            }
+        }
+        crate::dump::fnv1a64(&cfg)
+    }
+
+    /// State dump of the static collision data and the configuration constants.
+    pub fn export_static(&self) -> crate::dump::StaticDump {
+        use crate::dump::{STATIC_MAGIC, STATIC_VERSION, Wr, fnv1a64};
+        let (counts, sections) = self.static_sections(true);
+        let payload: Vec<u8> = sections.into_iter().flat_map(|(_, b)| b).collect();
+        let mut w = Wr::default();
+        w.0.extend_from_slice(&STATIC_MAGIC);
+        w.put_u32(STATIC_VERSION);
+        w.put_u64(fnv1a64(&payload));
+        w.put_u64(payload.len() as u64);
+        for c in counts {
+            w.put_u32(c);
+        }
+        w.0.extend_from_slice(&payload);
+        crate::dump::StaticDump(w.0)
+    }
+
+    /// The largest solver sizes seen since the arena was built or the stats were last reset.
+    pub fn dump_stats(&self) -> crate::dump::SolverStats {
+        self.bullet_world.dump_stats()
+    }
+
+    pub fn reset_dump_stats(&mut self) {
+        self.bullet_world.reset_dump_stats();
+    }
+
+    /// The ball body's activation code and deactivation time, for coverage counts of the ball's sleep.
+    pub fn ball_activation(&self) -> (u8, f32) {
+        let rb = &self.bullet_world.bodies()[self.ball.rigid_body_idx];
+        (rb.activation_code(), rb.deactivation_time)
+    }
+
+    /// The static sections (tag, bytes with the tag in front) in file order, and the header counts. With `full`
+    /// false the mesh bodies are skipped (they are what `config_hash` leaves out).
+    fn static_sections(
+        &self,
+        full: bool,
+    ) -> ([u32; crate::dump::STATIC_COUNTS], Vec<([u8; 4], Vec<u8>)>) {
+        use crate::dump::{StaticSections, tag};
+        let mut s = StaticSections::default();
+        let m = &self.config.mutators;
+        s.world.put_u8(self.config.game_mode as u8);
+        s.world.put_u8(u8::from(self.config.no_ball_rot));
+        s.world.put_idx(self.ball.rigid_body_idx);
+        s.world.put_vec3(m.gravity);
+        for f in [
+            m.car_mass,
+            m.ball_mass,
+            m.ball_max_speed,
+            m.ball_drag,
+            m.jump_accel,
+            m.jump_immediate_force,
+            m.boost_accel_ground,
+            m.boost_accel_air,
+            m.boost_used_per_second,
+            m.respawn_delay,
+            m.bump_cooldown_time,
+            m.car_max_boost_amount,
+            m.car_spawn_boost_amount,
+            m.boost_pad_amount_small,
+            m.boost_pad_amount_big,
+            m.boost_pad_cooldown_big,
+            m.boost_pad_cooldown_small,
+            m.ball_hit_extra_force_scale,
+            m.bump_force_scale,
+            m.ball_radius,
+        ] {
+            s.world.put_f32(f);
+        }
+        s.world.put_u8(u8::from(m.unlimited_flips));
+        s.world.put_u8(u8::from(m.unlimited_double_jumps));
+        s.world.put_u8(u8::from(m.recharge_boost_enabled));
+        s.world.put_f32(m.recharge_boost_per_second);
+        s.world.put_f32(m.recharge_boost_delay);
+        s.world.put_u8(m.demo_mode as u8);
+        s.world.put_u8(u8::from(m.enable_team_demos));
+        s.world.put_f32(m.goal_base_threshold_y);
+        s.world.put_u8(u8::from(m.boost_pads_enabled));
+
+        self.bullet_world.dump_static(&mut s, full);
+
+        for car in &self.cars {
+            s.cars.put_idx(car.idx);
+            s.cars.put_u8(car.team as u8);
+            s.cars.put_idx(car.rigid_body_idx);
+            s.cars.put_u8(u8::from(car.config.three_wheels));
+            s.cars.put_vec3(car.config.hitbox_size);
+            s.cars.put_vec3(car.config.hitbox_pos_offset);
+            for w in &car.bullet_vehicle.wheels {
+                s.cars.put_vec3(w.chassis_connection_point_cs);
+                s.cars.put_f32(w.suspension_rest_length_1);
+                s.cars.put_f32(w.wheels_radius);
+                s.cars.put_f32(w.suspension_force_scale);
+                s.cars.put_f32(w.real_ray_length);
+            }
+        }
+        s.counts[8] = self.cars.len() as u32;
+
+        if let Some(grid) = &self.boost_pad_grid {
+            s.pads.put_f32(grid.max_pad_z);
+            for pad in &grid.all_pads {
+                s.pads.put_vec3(pad.config.pos);
+                s.pads.put_u8(u8::from(pad.config.is_big));
+                s.pads.put_f32(pad.box_radius);
+                s.pads.put_f32(pad.cyl_radius);
+                s.pads.put_f32(pad.max_cooldown);
+                s.pads.put_f32(pad.boost_amount);
+                s.pads.put_aabb(&pad.aabb);
+            }
+            s.counts[9] = grid.all_pads.len() as u32;
+        }
+        self.bullet_world.dump_proxies(&mut s.proxies);
+
+        let section = |t: &[u8; 4], n: Option<u32>, body: &[u8]| {
+            let mut sec = tag(t).to_le_bytes().to_vec();
+            if let Some(n) = n {
+                sec.extend_from_slice(&n.to_le_bytes());
+            }
+            sec.extend_from_slice(body);
+            (*t, sec)
+        };
+        let sections = vec![
+            section(b"WRLD", None, &s.world.0),
+            section(b"BODY", None, &s.bodies.0),
+            section(b"MESH", Some(s.counts[2]), &s.meshes.0),
+            section(b"PLAN", Some(s.counts[7]), &s.planes.0),
+            section(b"CELL", None, &s.cells.0),
+            section(b"CARS", Some(s.counts[8]), &s.cars.0),
+            section(b"PADS", Some(s.counts[9]), &s.pads.0),
+            section(b"PROX", None, &s.proxies.0),
+        ];
+        (s.counts, sections)
+    }
+}
