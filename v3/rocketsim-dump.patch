diff --git b/rocketsim/src/dump.rs b/rocketsim/src/dump.rs
new file mode 100644
index 0000000..e33b94d
--- /dev/null
+++ b/rocketsim/src/dump.rs
@@ -0,0 +1,555 @@
+//! State dump (feature `dump`, added by the `rocketsim-dump` patch): the flat little-endian export and import of every piece
+//! of per-arena mutable state that persists across ticks, and the export of the static collision data.
+//! The format is the traversal in this file: the header counts, then each piece in `dump_io` order.
+//!
+//! One traversal serves both directions: every `dump_io` takes `&mut self` and an [`Io`], and either writes the fields
+//! out ([`Wr`]) or reads them back in ([`Rd`]), so the write order and the read order cannot differ.
+
+use glam::{Affine3A, Mat3A, Quat, Vec3A};
+
+use crate::{
+    BoostPad, Car, CarControls, CarState, RaycastHitInfo, UserInfoType,
+    bullet::collision::narrowphase::manifold_point::ManifoldPoint, shared::Aabb,
+};
+
+pub const ARENA_MAGIC: [u8; 8] = *b"V3ARENA\0";
+pub const STATIC_MAGIC: [u8; 8] = *b"V3STATIC";
+/// Arena dump version 2 adds each pad's `touching_car_idxs` (V3 0.3.3's pad membership, in arrival order).
+pub const VERSION: u32 = 2;
+/// Static dump version 2 adds the `PROX` section (the static broadphase proxies); version 3 adds `boost_pads_enabled` to `WRLD`
+/// and each car's hitbox size and offset to `CARS` (V3 0.3.3's pad box test).
+pub const STATIC_VERSION: u32 = 3;
+
+/// Section tags (ASCII, little-endian u32), written before each section and checked on read.
+pub const fn tag(t: &[u8; 4]) -> u32 {
+    u32::from_le_bytes(*t)
+}
+
+/// FNV-1a, 64 bit.
+pub fn fnv1a64(bytes: &[u8]) -> u64 {
+    let mut h = 0xcbf2_9ce4_8422_2325u64;
+    for &b in bytes {
+        h = (h ^ u64::from(b)).wrapping_mul(0x0000_0100_0000_01b3);
+    }
+    h
+}
+
+/// Direction-agnostic field codec. `READ` is true when the values are assigned from the stream.
+pub trait Io {
+    const READ: bool;
+    fn u8(&mut self, v: &mut u8);
+    fn u16(&mut self, v: &mut u16);
+    fn u32(&mut self, v: &mut u32);
+    fn u64(&mut self, v: &mut u64);
+    fn f32(&mut self, v: &mut f32);
+
+    fn bool(&mut self, v: &mut bool) {
+        let mut b = u8::from(*v);
+        self.u8(&mut b);
+        *v = b != 0;
+    }
+
+    /// An index as u32; `usize::MAX` (the island manager's "not dynamic") is 0xFFFF_FFFF.
+    fn idx(&mut self, v: &mut usize) {
+        let mut x = if *v == usize::MAX {
+            u32::MAX
+        } else {
+            u32::try_from(*v).expect("index overflows u32")
+        };
+        self.u32(&mut x);
+        *v = if x == u32::MAX {
+            usize::MAX
+        } else {
+            x as usize
+        };
+    }
+
+    fn i8(&mut self, v: &mut i8) {
+        let mut x = *v as u8;
+        self.u8(&mut x);
+        *v = x as i8;
+    }
+
+    fn i64(&mut self, v: &mut i64) {
+        let mut x = *v as u64;
+        self.u64(&mut x);
+        *v = x as i64;
+    }
+
+    /// Section tag: written as is, checked on read.
+    fn tag(&mut self, t: u32) {
+        let mut x = t;
+        self.u32(&mut x);
+        assert_eq!(x, t, "dump section tag mismatch");
+    }
+
+    /// Element count of a sequence: written from `n`, read back (and bounded by the bytes left) on import.
+    fn len(&mut self, n: usize) -> usize {
+        let mut x = n as u32;
+        self.u32(&mut x);
+        x as usize
+    }
+
+    fn vec3(&mut self, v: &mut Vec3A) {
+        self.f32(&mut v.x);
+        self.f32(&mut v.y);
+        self.f32(&mut v.z);
+    }
+
+    fn mat3(&mut self, m: &mut Mat3A) {
+        self.vec3(&mut m.x_axis);
+        self.vec3(&mut m.y_axis);
+        self.vec3(&mut m.z_axis);
+    }
+
+    fn aff3(&mut self, t: &mut Affine3A) {
+        self.mat3(&mut t.matrix3);
+        self.vec3(&mut t.translation);
+    }
+
+    fn quat(&mut self, q: &mut Quat) {
+        self.f32(&mut q.x);
+        self.f32(&mut q.y);
+        self.f32(&mut q.z);
+        self.f32(&mut q.w);
+    }
+
+    fn aabb(&mut self, a: &mut Aabb) {
+        self.vec3(&mut a.min);
+        self.vec3(&mut a.max);
+    }
+}
+
+/// Sequence of `T`: u32 count, then the elements.
+pub fn seq<I: Io, T>(
+    io: &mut I,
+    v: &mut Vec<T>,
+    make: impl Fn() -> T,
+    mut f: impl FnMut(&mut I, &mut T),
+) {
+    let n = io.len(v.len());
+    if I::READ {
+        v.clear();
+        v.resize_with(n, make);
+    }
+    for x in v.iter_mut() {
+        f(io, x);
+    }
+}
+
+/// Sequence of u32 indices (`usize` in memory).
+pub fn seq_idx<I: Io>(io: &mut I, v: &mut Vec<usize>) {
+    seq(io, v, || 0, |io, x| io.idx(x));
+}
+
+/// Sequence of u16.
+pub fn seq_u16<I: Io>(io: &mut I, v: &mut Vec<u16>) {
+    seq(io, v, || 0, |io, x| io.u16(x));
+}
+
+/// Sequence of u32.
+pub fn seq_u32<I: Io>(io: &mut I, v: &mut Vec<u32>) {
+    seq(io, v, || 0, |io, x| io.u32(x));
+}
+
+/// Optional value: u8 flag, then the payload always occupies its full size (zeros when absent).
+pub fn opt<I: Io, T>(
+    io: &mut I,
+    v: &mut Option<T>,
+    make: impl Fn() -> T,
+    f: impl FnOnce(&mut I, &mut T),
+) {
+    let mut some = v.is_some();
+    io.bool(&mut some);
+    let mut tmp = if I::READ {
+        make()
+    } else {
+        v.take().unwrap_or_else(make)
+    };
+    f(io, &mut tmp);
+    *v = some.then_some(tmp);
+}
+
+pub fn opt_idx<I: Io>(io: &mut I, v: &mut Option<usize>) {
+    opt(io, v, || 0, |io, x| io.idx(x));
+}
+
+pub fn opt_u64<I: Io>(io: &mut I, v: &mut Option<u64>) {
+    opt(io, v, || 0, |io, x| io.u64(x));
+}
+
+pub fn opt_vec3<I: Io>(io: &mut I, v: &mut Option<Vec3A>) {
+    opt(io, v, || Vec3A::ZERO, |io, x| io.vec3(x));
+}
+
+/// Writer.
+#[derive(Default)]
+pub struct Wr(pub Vec<u8>);
+
+impl Wr {
+    pub fn put_u8(&mut self, v: u8) {
+        self.0.push(v);
+    }
+    pub fn put_u16(&mut self, v: u16) {
+        self.0.extend_from_slice(&v.to_le_bytes());
+    }
+    pub fn put_u32(&mut self, v: u32) {
+        self.0.extend_from_slice(&v.to_le_bytes());
+    }
+    pub fn put_u64(&mut self, v: u64) {
+        self.0.extend_from_slice(&v.to_le_bytes());
+    }
+    pub fn put_f32(&mut self, v: f32) {
+        self.0.extend_from_slice(&v.to_bits().to_le_bytes());
+    }
+    pub fn put_idx(&mut self, v: usize) {
+        self.put_u32(if v == usize::MAX {
+            u32::MAX
+        } else {
+            u32::try_from(v).expect("index overflows u32")
+        });
+    }
+    pub fn put_vec3(&mut self, v: Vec3A) {
+        self.put_f32(v.x);
+        self.put_f32(v.y);
+        self.put_f32(v.z);
+    }
+    pub fn put_mat3(&mut self, m: Mat3A) {
+        self.put_vec3(m.x_axis);
+        self.put_vec3(m.y_axis);
+        self.put_vec3(m.z_axis);
+    }
+    pub fn put_aff3(&mut self, t: &Affine3A) {
+        self.put_mat3(t.matrix3);
+        self.put_vec3(t.translation);
+    }
+    pub fn put_aabb(&mut self, a: &Aabb) {
+        self.put_vec3(a.min);
+        self.put_vec3(a.max);
+    }
+}
+
+impl Io for Wr {
+    const READ: bool = false;
+    fn u8(&mut self, v: &mut u8) {
+        self.put_u8(*v);
+    }
+    fn u16(&mut self, v: &mut u16) {
+        self.put_u16(*v);
+    }
+    fn u32(&mut self, v: &mut u32) {
+        self.put_u32(*v);
+    }
+    fn u64(&mut self, v: &mut u64) {
+        self.put_u64(*v);
+    }
+    fn f32(&mut self, v: &mut f32) {
+        self.put_f32(*v);
+    }
+}
+
+/// Reader over a byte slice. A short read records an error, returns zero and the caller reports it at the end.
+pub struct Rd<'a> {
+    buf: &'a [u8],
+    pos: usize,
+    pub err: Option<&'static str>,
+}
+
+impl<'a> Rd<'a> {
+    pub const fn new(buf: &'a [u8]) -> Self {
+        Self {
+            buf,
+            pos: 0,
+            err: None,
+        }
+    }
+
+    pub const fn remaining(&self) -> usize {
+        self.buf.len() - self.pos
+    }
+
+    fn take<const N: usize>(&mut self) -> [u8; N] {
+        if self.remaining() < N {
+            self.err = Some("dump truncated");
+            self.pos = self.buf.len();
+            return [0; N];
+        }
+        let mut out = [0u8; N];
+        out.copy_from_slice(&self.buf[self.pos..self.pos + N]);
+        self.pos += N;
+        out
+    }
+}
+
+impl Io for Rd<'_> {
+    const READ: bool = true;
+    fn u8(&mut self, v: &mut u8) {
+        *v = self.take::<1>()[0];
+    }
+    fn u16(&mut self, v: &mut u16) {
+        *v = u16::from_le_bytes(self.take());
+    }
+    fn u32(&mut self, v: &mut u32) {
+        *v = u32::from_le_bytes(self.take());
+    }
+    fn u64(&mut self, v: &mut u64) {
+        *v = u64::from_le_bytes(self.take());
+    }
+    fn f32(&mut self, v: &mut f32) {
+        *v = f32::from_bits(u32::from_le_bytes(self.take()));
+    }
+    fn len(&mut self, _n: usize) -> usize {
+        let mut x = 0u32;
+        self.u32(&mut x);
+        if x as usize > self.remaining() {
+            // every element takes at least one byte
+            self.err = Some("dump count exceeds the bytes left");
+            return 0;
+        }
+        x as usize
+    }
+}
+
+/// Counts in the arena dump header (also a checksum of the structure read back).
+pub const ARENA_COUNTS: usize = 12;
+
+/// Per-arena mutable state, as a flat little-endian byte stream.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct ArenaDump(pub Vec<u8>);
+
+impl ArenaDump {
+    pub const HEADER_LEN: usize = 8 + 4 + 8 + 4 * ARENA_COUNTS;
+
+    pub fn from_bytes(bytes: Vec<u8>) -> Result<Self, String> {
+        if bytes.len() < Self::HEADER_LEN || bytes[..8] != ARENA_MAGIC {
+            return Err("not an arena dump (magic)".into());
+        }
+        if u32::from_le_bytes(bytes[8..12].try_into().unwrap()) != VERSION {
+            return Err("unsupported arena dump version".into());
+        }
+        Ok(Self(bytes))
+    }
+
+    pub fn as_bytes(&self) -> &[u8] {
+        &self.0
+    }
+
+    /// Hash of the static configuration the dump was taken from (header field).
+    pub fn config_hash(&self) -> u64 {
+        u64::from_le_bytes(self.0[12..20].try_into().unwrap())
+    }
+
+    pub fn counts(&self) -> [u32; ARENA_COUNTS] {
+        std::array::from_fn(|i| {
+            let o = 20 + 4 * i;
+            u32::from_le_bytes(self.0[o..o + 4].try_into().unwrap())
+        })
+    }
+}
+
+/// Static collision data and configuration constants, as a flat little-endian byte stream.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct StaticDump(pub Vec<u8>);
+
+pub const STATIC_COUNTS: usize = 12;
+
+impl StaticDump {
+    pub const HEADER_LEN: usize = 8 + 4 + 8 + 8 + 4 * STATIC_COUNTS;
+
+    /// Checks magic, version, the payload length and the payload hash.
+    pub fn from_bytes(bytes: Vec<u8>) -> Result<Self, String> {
+        if bytes.len() < Self::HEADER_LEN || bytes[..8] != STATIC_MAGIC {
+            return Err("not a static dump (magic)".into());
+        }
+        if u32::from_le_bytes(bytes[8..12].try_into().unwrap()) != STATIC_VERSION {
+            return Err("unsupported static dump version".into());
+        }
+        let d = Self(bytes);
+        if d.payload_len() != d.0.len() - Self::HEADER_LEN {
+            return Err("static dump payload length mismatch".into());
+        }
+        if fnv1a64(&d.0[Self::HEADER_LEN..]) != d.hash() {
+            return Err("static dump payload hash mismatch".into());
+        }
+        Ok(d)
+    }
+
+    pub fn as_bytes(&self) -> &[u8] {
+        &self.0
+    }
+
+    pub fn hash(&self) -> u64 {
+        u64::from_le_bytes(self.0[12..20].try_into().unwrap())
+    }
+
+    pub fn payload_len(&self) -> usize {
+        u64::from_le_bytes(self.0[20..28].try_into().unwrap()) as usize
+    }
+
+    pub fn counts(&self) -> [u32; STATIC_COUNTS] {
+        std::array::from_fn(|i| {
+            let o = 28 + 4 * i;
+            u32::from_le_bytes(self.0[o..o + 4].try_into().unwrap())
+        })
+    }
+}
