+
+#[cfg(feature = "dump")]
+impl AxisSweep3 {
+    /// State dump of the sweep-and-prune state: handles, edge arrays, free list and the pair cache.
+    pub(super) fn dump_io<I: crate::dump::Io>(&mut self, io: &mut I) {
+        use crate::dump::{seq, seq_u16};
+        seq(io, &mut self.handles, BroadphaseProxy::default, |io, h| {
+            io.u32(&mut h.client_obj_idx);
+            io.u8(&mut h.collision_filter_group);
+            io.u8(&mut h.collision_filter_mask);
+            io.u32(&mut h.unique_id);
+            io.aabb(&mut h.aabb);
+            io.u32(&mut h.cell_idx);
+            for i in &mut h.indices {
+                io.u32(i);
+            }
+        });
+        seq(io, &mut self.handle_edges, HandleEdges::default, |io, e| {
+            for v in e.min.iter_mut().chain(e.max.iter_mut()) {
+                io.u16(v);
+            }
+        });
+        for axis in &mut self.edges {
+            seq(io, axis, Edge::default, |io, e| {
+                io.u16(&mut e.pos);
+                io.u16(&mut e.handle);
+            });
+        }
+        io.u16(&mut self.num_handles);
+        seq_u16(io, &mut self.free_list);
+        io.u16(&mut self.next_new_handle);
+        self.pair_cache.dump_io(io);
+    }
+
+    /// State dump of the constants.
+    pub(super) fn dump_static(&self, w: &mut crate::dump::Wr) {
+        w.put_vec3(self.world_aabb_min);
+        w.put_vec3(self.quantize);
+        w.put_u16(AXIS_SWEEP_HANDLE_MASK);
+        w.put_u16(AXIS_SWEEP_SENTINEL);
+        w.put_u16(AXIS_SWEEP_MAX_HANDLES);
+        w.put_f32(AXIS_SWEEP_WORLD_HALF_EXTENT);
+    }
+}
diff --git a/rocketsim/src/bullet/collision/broadphase/grid_broadphase.rs b/rocketsim/src/bullet/collision/broadphase/grid_broadphase.rs
index beb5814..5fccb8d 100644
--- a/rocketsim/src/bullet/collision/broadphase/grid_broadphase.rs
+++ b/rocketsim/src/bullet/collision/broadphase/grid_broadphase.rs
@@ -425,3 +425,125 @@ impl GridBroadphase {
         }
     }
 }
+
+#[cfg(feature = "dump")]
+impl GridBroadphase {
+    /// State dump of the broadphase: the dynamic ray-cell lists (order matters for the ray candidate order, empty
+    /// cells are omitted) and the sweep-and-prune state. `island_dynamic_pairs` is derived scratch.
+    pub(crate) fn dump_io<I: crate::dump::Io>(&mut self, io: &mut I) {
+        let mut cells: Vec<(usize, Vec<usize>)> = self
+            .cell_grid
+            .cells
+            .iter()
+            .enumerate()
+            .filter(|(_, c)| !c.dyn_handles.is_empty())
+            .map(|(i, c)| (i, c.dyn_handles.clone()))
+            .collect();
+        crate::dump::seq(
+            io,
+            &mut cells,
+            || (0, Vec::new()),
+            |io, (i, handles)| {
+                io.idx(i);
+                crate::dump::seq_idx(io, handles);
+            },
+        );
+        if I::READ {
+            for c in self.cell_grid.cells.iter_mut() {
+                c.dyn_handles.clear();
+            }
+            for (i, handles) in cells {
+                self.cell_grid.cells[i].dyn_handles = handles;
+            }
+        }
+        self.axis_sweep.dump_io(io);
+    }
+
+    /// State dump of the broadphase constants (world section) and the static ray-cell lists (cell section).
+    pub(crate) fn dump_static(
+        &self,
+        world: &mut crate::dump::Wr,
+        cells: &mut crate::dump::Wr,
+    ) -> [u32; 2] {
+        let g = &self.cell_grid;
+        world.put_vec3(g.min_pos);
+        world.put_vec3(g.max_pos);
+        world.put_f32(g.cell_size);
+        world.put_f32(g.cell_size_sq);
+        world.put_idx(g.num_cells.x);
+        world.put_idx(g.num_cells.y);
+        world.put_idx(g.num_cells.z);
+        self.axis_sweep.dump_static(world);
+
+        let occupied: Vec<_> = g
+            .cells
+            .iter()
+            .enumerate()
+            .filter(|(_, c)| !c.static_handles.is_empty())
+            .collect();
+        cells.put_idx(occupied.len());
+        let mut entries = 0;
+        for (i, c) in occupied {
+            cells.put_idx(i);
+            cells.put_idx(c.static_handles.len());
+            for &h in &c.static_handles {
+                cells.put_idx(h);
+            }
+            entries += c.static_handles.len();
+        }
+        [g.cells.len() as u32, entries as u32]
+    }
+}
+
+#[cfg(feature = "dump")]
+impl GridBroadphase {
+    /// The constant part of every sweep-and-prune proxy: `u32 n`, then per handle (index 0 is the sentinel)
+    /// client body, filter group and mask, unique id, box, cell and cell indices. A dynamic body's box and cells move
+    /// every tick and are written as zero; a static body's never change.
+    pub(crate) fn dump_proxies(&self, w: &mut crate::dump::Wr) {
+        let handles = self.axis_sweep.handles();
+        w.put_u32(handles.len() as u32);
+        for p in handles {
+            let is_static = p.collision_filter_group & CollisionFilterGroups::Static as u8 != 0;
+            w.put_u32(p.client_obj_idx);
+            w.put_u8(p.collision_filter_group);
+            w.put_u8(p.collision_filter_mask);
+            w.put_u32(p.unique_id);
+            if is_static {
+                w.put_aabb(&p.aabb);
+                w.put_u32(p.cell_idx);
+                for i in p.indices {
+                    w.put_u32(i);
+                }
+            } else {
+                w.put_aabb(&crate::shared::Aabb::default());
+                w.put_u32(0);
+                for _ in 0..3 {
+                    w.put_u32(0);
+                }
+            }
+        }
+    }
+
+    /// Collision filter group and mask of a proxy.
+    pub(crate) fn dump_filter(&self, handle: usize) -> (u8, u8) {
+        let p = self.axis_sweep.proxy(handle);
+        (p.collision_filter_group, p.collision_filter_mask)
+    }
+}
+
+#[cfg(feature = "dump")]
+impl GridBroadphase {
+    /// Header counts: sweep-and-prune handles, retained pairs, dynamic ray-cell entries.
+    pub(crate) fn dump_counts(&self) -> [u32; 3] {
+        [
+            self.axis_sweep.handles().len() as u32,
+            self.axis_sweep.retained_pairs().len() as u32,
+            self.cell_grid
+                .cells
+                .iter()
+                .map(|c| c.dyn_handles.len() as u32)
+                .sum(),
+        ]
+    }
+}
