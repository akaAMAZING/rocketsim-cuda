+#[cfg(feature = "dump")]
+impl Tree {
+    /// State dump of the built 4-wide tree, nodes and leaves in storage order.
+    /// Returns the node and leaf counts.
+    pub fn dump_static(&self, w: &mut crate::dump::Wr) -> [usize; 2] {
+        w.put_aabb(&self.aabb);
+        w.put_idx(self.wide_nodes.len());
+        for n in self.wide_nodes.iter() {
+            for v in [n.min_x, n.min_y, n.min_z, n.max_x, n.max_y, n.max_z] {
+                for l in v.to_array() {
+                    w.put_f32(l);
+                }
+            }
+            for c in n.children {
+                w.put_u32(c.0);
+            }
+            w.put_u8(n.child_count);
+            w.put_u32(n.valid_mask);
+        }
+        w.put_idx(self.leaves.len());
+        for l in self.leaves.iter() {
+            w.put_aabb(&l.bounds);
+            w.put_idx(l.leaf_idx);
+        }
+        [self.wide_nodes.len(), self.leaves.len()]
+    }
+}
