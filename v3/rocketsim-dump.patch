+
+fn io_controls<I: Io>(io: &mut I, c: &mut CarControls) {
+    io.f32(&mut c.throttle);
+    io.f32(&mut c.steer);
+    io.f32(&mut c.pitch);
+    io.f32(&mut c.yaw);
+    io.f32(&mut c.roll);
+    io.bool(&mut c.jump);
+    io.bool(&mut c.boost);
+    io.bool(&mut c.handbrake);
+}
+
+fn io_user_info<I: Io>(io: &mut I, u: &mut UserInfoType) {
+    let mut x = *u as u8;
+    io.u8(&mut x);
+    *u = match x {
+        1 => UserInfoType::Car,
+        2 => UserInfoType::Ball,
+        3 => UserInfoType::DropshotTile,
+        _ => UserInfoType::None,
+    };
+}
+
+fn io_hit<I: Io>(io: &mut I, h: &mut RaycastHitInfo) {
+    io.vec3(&mut h.hit_point);
+    io.vec3(&mut h.hit_normal);
+    io.f32(&mut h.hit_fraction);
+    io_user_info(io, &mut h.user_info);
+}
+
+pub fn io_manifold_point<I: Io>(io: &mut I, p: &mut ManifoldPoint) {
+    io.vec3(&mut p.local_point_a);
+    io.vec3(&mut p.local_point_b);
+    io.vec3(&mut p.pos_world_on_b);
+    io.vec3(&mut p.pos_world_on_a);
+    io.vec3(&mut p.normal_world_on_b);
+    io.f32(&mut p.distance_1);
+    io.f32(&mut p.combined_friction);
+    io.f32(&mut p.combined_restitution);
+    io.f32(&mut p.applied_impulse);
+    io.bool(&mut p.is_special);
+}
+
+fn io_car_state<I: Io>(io: &mut I, s: &mut CarState) {
+    io.vec3(&mut s.phys.pos);
+    io.mat3(&mut s.phys.rot_mat);
+    io.vec3(&mut s.phys.vel);
+    io.vec3(&mut s.phys.ang_vel);
+    io_controls(io, &mut s.controls);
+    io.bool(&mut s.has_jumped);
+    io.bool(&mut s.has_double_jumped);
+    io.bool(&mut s.has_flipped);
+    io.vec3(&mut s.flip_rel_torque);
+    io.u32(&mut s.jump_ticks);
+    io.f32(&mut s.flip_time);
+    io.bool(&mut s.is_flipping);
+    io.bool(&mut s.is_jumping);
+    io.bool(&mut s.jump_hold_broken);
+    io.f32(&mut s.air_time);
+    io.f32(&mut s.air_time_since_jump);
+    io.f32(&mut s.boost);
+    io.f32(&mut s.handbrake_val);
+    io.bool(&mut s.is_supersonic);
+    io.f32(&mut s.supersonic_grace_timer);
+    io.f32(&mut s.time_since_boosted);
+    io.f32(&mut s.boosting_time);
+    io.bool(&mut s.is_boosting);
+    io.bool(&mut s.is_auto_flipping);
+    io.f32(&mut s.auto_flip_timer);
+    io.f32(&mut s.auto_flip_torque_scale);
+    io.f32(&mut s.bump_cooldown_timer);
+    opt_idx(io, &mut s.bump_cooldown_victim);
+    opt_u64(io, &mut s.last_extra_hit_tick);
+    io.bool(&mut s.is_demoed);
+    io.f32(&mut s.demo_respawn_timer);
+    io.bool(&mut s.cache.is_on_ground);
+    for h in &mut s.cache.wheels_with_contact {
+        opt(
+            io,
+            h,
+            || RaycastHitInfo {
+                hit_point: Vec3A::ZERO,
+                hit_normal: Vec3A::ZERO,
+                hit_fraction: 0.0,
+                user_info: UserInfoType::None,
+            },
+            io_hit,
+        );
+    }
+    opt_vec3(io, &mut s.cache.world_contact_normal);
+    io_controls(io, &mut s.cache.prev_controls);
+}
+
+pub fn io_car<I: Io>(io: &mut I, c: &mut Car) {
+    io.f32(&mut c.info.config.dodge_deadzone);
+    io.vec3(&mut c.vel_impulse_cache);
+    io.bool(&mut c.sticky_gate_prev);
+    io_car_state(io, &mut c.state);
+    for w in &mut c.bullet_vehicle.wheels {
+        w.dump_io(io);
+    }
+}
+
+pub(crate) fn io_pad<I: Io>(io: &mut I, p: &mut BoostPad) {
+    let mut last = p.gave_boost_tick_count;
+    opt(io, &mut last, || 0, |io, x| io.i64(x));
+    p.gave_boost_tick_count = last;
+    // The grid's `winners` and `touching_pad_by_car` are scratch: update_membership refills both before any read.
+    seq_idx(io, &mut p.touching_car_idxs);
+}
+
+pub(crate) fn io_ball<I: Io>(io: &mut I, b: &mut crate::Ball) {
+    let s = &mut b.state;
+    io.vec3(&mut s.phys.pos);
+    io.mat3(&mut s.phys.rot_mat);
+    io.vec3(&mut s.phys.vel);
+    io.vec3(&mut s.phys.ang_vel);
+    io.i8(&mut s.hs_info.y_target_dir);
+    io.f32(&mut s.hs_info.cur_target_speed);
+    io.f32(&mut s.hs_info.time_since_hit);
+    io.u8(&mut s.ds_info.charge_level);
+    io.f32(&mut s.ds_info.accumulated_hit_force);
+    io.i8(&mut s.ds_info.y_target_dir);
+    opt_u64(io, &mut s.ds_info.last_damage_tick);
+    io.u64(&mut s.tick_count_since_kickoff);
+    io.bool(&mut b.ground_stick_applied);
+}
