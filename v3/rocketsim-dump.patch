+#[cfg(feature = "dump")]
+impl SimulationIslandManager {
+    /// State dump of the island manager: the union-find scratch and the sort cache.
+    /// The cache is a memo of the sort and never changes a result; it is exported so that two arenas compare equal.
+    /// `island_has_active_body` is not: `sort_manifolds` resizes and clears it before every read.
+    pub(super) fn dump_io<I: crate::dump::Io>(&mut self, io: &mut I) {
+        use crate::dump::{seq, seq_idx};
+        seq_idx(io, &mut self.body_to_dynamic);
+        seq_idx(io, &mut self.parents);
+        seq(io, &mut self.island_tags, || 0, |io, x| io_isize(io, x));
+        seq(io, &mut self.sort_keys, || 0, |io, x| io_isize(io, x));
+        for cache in [&mut self.cached_input, &mut self.cached_output] {
+            let mut v: Vec<usize> = cache.iter().copied().collect();
+            seq_idx(io, &mut v);
+            if I::READ {
+                cache.clear();
+                cache
+                    .try_extend_from_slice(&v)
+                    .expect("cache over capacity");
+            }
+        }
+    }
+}
+
+#[cfg(feature = "dump")]
+fn io_isize<I: crate::dump::Io>(io: &mut I, v: &mut isize) {
+    let mut x = *v as i64;
+    io.i64(&mut x);
+    *v = x as isize;
+}
