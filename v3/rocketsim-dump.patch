+#[cfg(feature = "dump")]
+impl BvhTriangleMeshShape {
+    /// State dump of one mesh: triangles in index order, the built BVH, the triangle info map.
+    /// `counts` receives the totals of wide nodes, leaves and triangle infos.
+    pub(crate) fn dump_static(&self, w: &mut crate::dump::Wr, counts: &mut [u32]) {
+        w.put_aabb(&self.aabb_ident_cache);
+        let tris = self.mesh_interface.get_tris();
+        w.put_idx(tris.len());
+        for t in tris {
+            for p in t.points {
+                w.put_vec3(p);
+            }
+            w.put_vec3(t.normal);
+        }
+        let [nodes, leaves] = self.bvh.dump_static(w);
+        counts[4] += nodes as u32;
+        counts[5] += leaves as u32;
+        w.put_idx(self.triangle_info_map.len());
+        counts[6] += self.triangle_info_map.len() as u32;
+        for info in self.triangle_info_map.iter() {
+            w.put_u8(info.flags);
+            w.put_f32(info.edge_v0_v1_angle);
+            w.put_f32(info.edge_v1_v2_angle);
+            w.put_f32(info.edge_v2_v0_angle);
+        }
+    }
+}
