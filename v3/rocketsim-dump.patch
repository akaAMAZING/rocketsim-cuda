+#[cfg(feature = "dump")]
+impl PersistentManifold {
+    /// State dump of one retained manifold: the four point slots are always present, in cache order.
+    pub(crate) fn dump_io<I: crate::dump::Io>(&mut self, io: &mut I) {
+        io.idx(&mut self.body0_idx);
+        io.idx(&mut self.body1_idx);
+        io.u64(&mut self.pair_key);
+        io.f32(&mut self.contact_breaking_threshold);
+        io.f32(&mut self.contact_processing_threshold);
+        let mut n = self.point_cache.len() as u32;
+        io.u32(&mut n);
+        if I::READ {
+            self.point_cache.clear();
+            for _ in 0..(n as usize).min(MANIFOLD_CACHE_SIZE) {
+                self.point_cache.push(ManifoldPoint::default());
+            }
+        }
+        for i in 0..MANIFOLD_CACHE_SIZE {
+            let mut p = self.point_cache.get(i).copied().unwrap_or_default();
+            crate::dump::io_manifold_point(io, &mut p);
+            if I::READ && i < self.point_cache.len() {
+                self.point_cache[i] = p;
+            }
+        }
+    }
+}
+
+#[cfg(feature = "dump")]
+impl PersistentManifold {
+    pub(crate) fn new_empty() -> Self {
+        Self {
+            point_cache: ArrayVec::new(),
+            body0_idx: 0,
+            body1_idx: 0,
+            pair_key: 0,
+            contact_breaking_threshold: 0.0,
+            contact_processing_threshold: 0.0,
+        }
+    }
+}
